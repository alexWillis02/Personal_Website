---
import { NAV, SITE } from "../consts";
import { url } from "../lib/utils";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function isActive(href: string) {
  const target = (base + href).replace(/\/$/, "") || "/";
  if (href === "/") {
    // "roundup" is the home page and owns the /roundup/ archive too.
    return current === target || current.startsWith(`${base}/roundup`);
  }
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url()} aria-label={`${SITE.name}, home`}>
      <span class="prompt" aria-hidden="true">~/</span>{SITE.handle}<span
        class="cursor"
        aria-hidden="true"></span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch to light theme">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const root = document.documentElement;

  function sync() {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
  }

  button.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });

  sync();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 3.75rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .prompt {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  nav {
    order: 3;
    width: 100%;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    color: var(--accent);
  }

  nav a[aria-current="page"]::before {
    content: "> ";
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  :global([data-theme="dark"]) .icon-moon,
  :global([data-theme="light"]) .icon-sun {
    display: none;
  }

  @media (min-width: 48rem) {
    nav {
      order: 0;
      width: auto;
      margin-left: auto;
    }

    .theme-toggle {
      margin-left: 0;
    }
  }
</style>
