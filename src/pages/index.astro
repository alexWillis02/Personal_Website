---
import Base from "../layouts/Base.astro";
import Roundup from "../components/Roundup.astro";
import SpecSheet from "../components/SpecSheet.astro";
import { SITE } from "../consts";
import { getProjects, getRoundups, getThoughts } from "../lib/content";
import { formatDate, url } from "../lib/utils";

const roundups = await getRoundups();
const [latest, ...older] = roundups;
const previous = older.slice(0, 7);
const thoughts = (await getThoughts()).slice(0, 3);
const projects = (await getProjects()).slice(0, 4);
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">BYU Mechanical Engineering '27 · Aerospace</p>
        <h1>{SITE.name}</h1>
        <p class="tagline">{SITE.tagline}</p>
        <p class="status">
          <span class="dot" aria-hidden="true"></span>
          Currently: ME intern on the Rogue 1 UAV program at Teledyne FLIR Defense
        </p>
        <p class="actions">
          <a class="button" href={url("/resume/")}>View resume</a>
          <a class="button ghost" href={url("/projects/")}>Projects</a>
        </p>
      </div>

      <!-- Decorative: a flight trajectory with altitude ticks. -->
      <svg class="trajectory" viewBox="0 0 420 260" aria-hidden="true">
        <g class="axes">
          <line x1="30" y1="230" x2="410" y2="230"></line>
          <line x1="30" y1="230" x2="30" y2="20"></line>
          {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
            <line x1={30 + i * 50} y1="230" x2={30 + i * 50} y2="236"></line>
          ))}
          {[0, 1, 2, 3, 4].map((i) => (
            <line x1="24" y1={230 - i * 50} x2="30" y2={230 - i * 50}></line>
          ))}
        </g>
        <path class="arc-ghost" d="M30 228 C 130 210, 190 40, 300 44 S 400 120, 410 150"></path>
        <path class="arc" d="M30 228 C 130 210, 190 40, 300 44"></path>
        <g class="craft" transform="translate(300 44) rotate(78)">
          <path d="M0 -11 L8 8 L0 4 L-8 8 Z"></path>
        </g>
        <text x="306" y="30">APOGEE</text>
        <text x="36" y="252">T+00:00</text>
        <text x="340" y="252">T+07:00</text>
      </svg>
    </div>
  </section>

  <div class="container home">
    <div class="cover">
      {
        latest ? (
          <Roundup roundup={latest} level={2} />
        ) : (
          <p class="empty">
            No briefing yet. The daily routine will publish one here.
          </p>
        )
      }
    </div>

    <aside class="rail" aria-label="About and more">
      <SpecSheet />

      {
        previous.length > 0 && (
          <section class="card">
            <h2 class="section-title">Previous briefings</h2>
            <ul class="list">
              {previous.map((r) => (
                <li>
                  <a href={url(`/roundup/${r.id}/`)}>
                    {formatDate(r.data.date, "short")}
                  </a>
                </li>
              ))}
            </ul>
            <a class="more" href={url("/roundup/")}>All briefings →</a>
          </section>
        )
      }

      {
        projects.length > 0 && (
          <section class="card">
            <h2 class="section-title">Projects</h2>
            <ul class="list">
              {projects.map((p) => (
                <li>
                  <a href={url(`/projects/${p.id}/`)}>{p.data.title}</a>
                  <span>{p.data.description}</span>
                </li>
              ))}
            </ul>
            <a class="more" href={url("/projects/")}>All projects →</a>
          </section>
        )
      }

      {
        thoughts.length > 0 && (
          <section class="card">
            <h2 class="section-title">Latest thoughts</h2>
            <ul class="list">
              {thoughts.map((t) => (
                <li>
                  <a href={url(`/thoughts/${t.id}/`)}>{t.data.title}</a>
                  <time datetime={t.data.date.toISOString()}>
                    {formatDate(t.data.date, "short")}
                  </time>
                </li>
              ))}
            </ul>
            <a class="more" href={url("/thoughts/")}>All thoughts →</a>
          </section>
        )
      }
    </aside>
  </div>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, var(--accent-soft), transparent 70%);
  }

  .hero-inner {
    display: grid;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }

  @media (min-width: 56rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 8vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .tagline {
    margin: 1.1rem 0 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    color: var(--muted);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgb(61 220 132 / 0.6);
    animation: ping 2s ease-out infinite;
  }

  @keyframes ping {
    70% {
      box-shadow: 0 0 0 8px rgb(61 220 132 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(61 220 132 / 0);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.75rem 0 0;
  }

  .trajectory {
    display: none;
    width: 100%;
    max-width: 30rem;
    justify-self: end;
    overflow: visible;
  }

  @media (min-width: 56rem) {
    .trajectory {
      display: block;
    }
  }

  .axes line {
    stroke: var(--faint);
    stroke-width: 1;
  }

  .arc-ghost {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1.25;
    stroke-dasharray: 3 6;
  }

  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: draw 2.4s ease-out 0.3s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc {
      stroke-dashoffset: 0;
    }
  }

  .craft path {
    fill: var(--accent);
  }

  .trajectory text {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    fill: var(--muted);
  }

  /* ---------- Briefing + rail ---------- */

  .home {
    display: grid;
    gap: 3rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 62rem) {
    .home {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }

    .rail {
      position: sticky;
      top: 5.5rem;
    }
  }

  .rail {
    display: grid;
    gap: 1rem;
  }

  .card {
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .list {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .list li {
    display: grid;
  }

  .list a {
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .list a:hover {
    color: var(--accent);
  }

  .list time,
  .list span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
