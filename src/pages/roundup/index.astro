---
import Base from "../../layouts/Base.astro";
import { getRoundups, teaser } from "../../lib/content";
import { formatDate, url } from "../../lib/utils";

const roundups = await getRoundups();

// Group editions by month for easier scanning.
const months = new Map<string, typeof roundups>();
for (const r of roundups) {
  const key = r.data.date.toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "long",
    year: "numeric",
  });
  months.set(key, [...(months.get(key) ?? []), r]);
}
---

<Base title="Briefing archive" description="Every edition of the daily briefing.">
  <div class="container narrow">
    <header class="page-head">
      <p class="eyebrow">Sec-01 // Briefing archive</p>
      <h1>Briefing archive</h1>
      <p>
        A daily briefing on AI, space, drones and defense tech, and automotive
        engineering, researched and written each morning by an automated
        Claude routine.
        Also available as an <a href={url("rss.xml")}>RSS feed</a>.
      </p>
    </header>

    {roundups.length === 0 && <p class="empty">No briefings yet.</p>}

    {
      [...months].map(([month, entries]) => (
        <section class="month">
          <h2 class="section-title">{month}</h2>
          <ul>
            {entries.map((r) => (
              <li>
                <a href={url(`/roundup/${r.id}/`)}>
                  <time datetime={r.data.date.toISOString()}>
                    {formatDate(r.data.date)}
                  </time>
                </a>
                <span>{teaser(r)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .month + .month {
    margin-top: 2rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }

  li a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  li a:hover {
    color: var(--accent);
  }

  li span {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
