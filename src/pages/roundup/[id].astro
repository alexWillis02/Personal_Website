---
// Briefings used to live at /roundup/<date>/.
import type { GetStaticPaths } from "astro";
import Redirect from "../../components/Redirect.astro";
import { getRoundups } from "../../lib/content";
import { url } from "../../lib/utils";

export const getStaticPaths = (async () =>
  (await getRoundups()).map((r) => ({ params: { id: r.id } }))) satisfies GetStaticPaths;

const { id } = Astro.params;
---

<Redirect to={url(`/briefings/${id}/`)} />
