---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

// Drop photos into src/assets/gallery/ and they appear here automatically,
// resized and compressed at build time. The filename becomes the caption and
// alt text: "sunset-over-the-lake.jpg" -> "Sunset over the lake".
// Prefix with a number to control order: "01-sunset.jpg".
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([file, mod]) => {
    const name = file
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]/, "")
      .replace(/[-_]+/g, " ");
    return {
      src: mod.default,
      caption: name.charAt(0).toUpperCase() + name.slice(1),
    };
  });
---

<Base title="Gallery" description="Photos.">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Sec-05 // Imagery</p>
      <h1>Gallery</h1>
      <p>Builds, test days, flights, and everything in between.</p>
    </header>

    {
      photos.length === 0 ? (
        <p class="empty">
          No photos yet. Add images to <code>src/assets/gallery/</code>.
        </p>
      ) : (
        <ul class="grid">
          {photos.map((photo) => (
            <li>
              <figure>
                <a href={photo.src.src}>
                  <Image
                    src={photo.src}
                    alt={photo.caption}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                    loading="lazy"
                  />
                </a>
                <figcaption>{photo.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .grid {
    columns: 3 18rem;
    column-gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  figure {
    margin: 0;
  }

  figure a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  figure img {
    width: 100%;
    transition: transform 0.3s ease;
  }

  figure a:hover img {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
