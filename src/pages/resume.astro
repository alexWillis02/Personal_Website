---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import SpecSheet from "../components/SpecSheet.astro";
import { SITE } from "../consts";
import {
  certifications,
  education,
  jobs,
  languages,
  revision,
  skills,
  summary,
} from "../data/resume";
import { url } from "../lib/utils";

// Only show the download button once a PDF has been added.
const hasPdf = fs.existsSync(path.join(process.cwd(), "public", "resume.pdf"));
---

<Base title="Resume" description={`Experience, skills, and education of ${SITE.name}.`}>
  <div class="container">
    <header class="page-head head">
      <div>
        <p class="eyebrow">Doc AW-RES-001 // Resume</p>
        <h1>Resume</h1>
        <p>{summary}</p>
        <p class="actions">
          {
            hasPdf && (
              <a class="button" href={url("resume.pdf")}>
                Download PDF
              </a>
            )
          }
          <a class="button ghost" href={`mailto:${SITE.email}`}>
            Email me
          </a>
        </p>
      </div>
      <SpecSheet title="Quick reference" />
    </header>

    <!-- Engineering-drawing style title block. -->
    <dl class="title-block" aria-label="Document details">
      <div class="wide"><dt>Name</dt><dd>Alexander G. Willis</dd></div>
      <div class="wide"><dt>Discipline</dt><dd>Mechanical Engineering · Aerospace</dd></div>
      <div><dt>Dwg no.</dt><dd>AW-RES-001</dd></div>
      <div><dt>Rev</dt><dd>{revision}</dd></div>
      <div><dt>Sheet</dt><dd>1 of 1</dd></div>
    </dl>

    <div class="layout">
      <section aria-labelledby="experience" class="main">
        <h2 class="section-title" id="experience">Experience</h2>
        <ol class="timeline">
          {
            jobs.map((job) => (
              <li class:list={{ current: job.current }}>
                <p class="when">
                  {job.dates}
                  {job.location && <span> · {job.location}</span>}
                </p>
                <h3>{job.role}</h3>
                <p class="org">
                  {job.company}
                  {job.program && <span> / {job.program}</span>}
                </p>
                {job.highlights.length > 0 && (
                  <ul>
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>

        <h2 class="section-title" id="education">Education</h2>
        <ol class="timeline">
          {
            education.map((ed) => (
              <li>
                <p class="when">
                  {ed.dates} · {ed.location}
                </p>
                <h3>{ed.school}</h3>
                <p class="org">{ed.degree}</p>
                {ed.detail && <p class="detail">{ed.detail}</p>}
              </li>
            ))
          }
        </ol>
      </section>

      <aside class="side" aria-label="Skills and certifications">
        <section aria-labelledby="skills">
          <h2 class="section-title" id="skills">Technical skills</h2>
          {
            Object.entries(skills).map(([group, items]) => (
              <div class="skill-group">
                <h3>{group}</h3>
                <ul class="tags">
                  {items.map((s) => (
                    <li class="tag">{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        <section aria-labelledby="certs">
          <h2 class="section-title" id="certs">Certifications</h2>
          <ul class="plain">
            {certifications.map((c) => <li>{c}</li>)}
          </ul>
        </section>

        <section aria-labelledby="langs">
          <h2 class="section-title" id="langs">Languages</h2>
          <ul class="plain">
            {languages.map((l) => <li>{l}</li>)}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .head {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 56rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) 21rem;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem !important;
  }

  /* ---------- Title block ---------- */

  .title-block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 3rem;
    border: 1px solid var(--muted);
    font-family: var(--font-mono);
  }

  @media (min-width: 48rem) {
    .title-block {
      grid-template-columns: 2fr 2fr 1fr 1fr 1fr;
    }
  }

  .title-block div {
    padding: 0.5rem 0.75rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .title-block .wide {
    grid-column: span 2;
  }

  .title-block div:last-child {
    grid-column: span 2;
  }

  @media (min-width: 48rem) {
    .title-block .wide,
    .title-block div:last-child {
      grid-column: auto;
    }

    .title-block div {
      border-bottom: 0;
    }

    .title-block div:last-child {
      border-right: 0;
    }
  }

  .title-block dt {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .title-block dd {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
  }

  /* ---------- Layout ---------- */

  .layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 62rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 21rem;
    }
  }

  .main .section-title:not(:first-child) {
    margin-top: 3rem;
  }

  /* ---------- Timeline ---------- */

  .timeline {
    margin: 0;
    padding: 0 0 0 1.5rem;
    list-style: none;
    border-left: 1px solid var(--border);
  }

  .timeline > li {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0.5rem;
  }

  /* Node marker on the timeline. */
  .timeline > li::before {
    content: "";
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 0.3rem;
    width: 9px;
    height: 9px;
    background: var(--bg);
    border: 2px solid var(--muted);
    transform: rotate(45deg);
  }

  .timeline > li.current::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .when {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .when span {
    color: var(--faint);
  }

  h3 {
    margin: 0.3rem 0 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .org {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .org span {
    color: var(--faint);
  }

  .detail {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .timeline ul {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
  }

  .timeline ul li {
    padding-left: 0.2rem;
  }

  .timeline ul li::marker {
    content: "▸ ";
    color: var(--accent);
  }

  .timeline ul li + li {
    margin-top: 0.4rem;
  }

  /* ---------- Side column ---------- */

  .side {
    display: grid;
    gap: 2.25rem;
    align-content: start;
  }

  .skill-group + .skill-group {
    margin-top: 1.1rem;
  }

  .skill-group h3 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }

  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plain li {
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.925rem;
  }
</style>
