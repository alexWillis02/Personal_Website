---
import Base from "./Base.astro";
import { formatDate, url } from "../lib/utils";

interface Props {
  title: string;
  description: string;
  date: Date;
  eyebrow: string;
  back: { href: string; label: string };
  tags?: string[];
}

const { title, description, date, eyebrow, back, tags = [] } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container narrow post">
    <a class="back" href={url(back.href)}>← {back.label}</a>
    <header class="page-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
      <slot name="actions" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post {
    padding-top: 2rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .page-head {
    padding-top: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
